# Copy to .env (git-ignored), fill in real values, then load it before running:
#   set -a; source .env; set +a; ./mvnw spring-boot:run

# Database (DB_HOST, DB_PORT, DB_NAME, DB_USERNAME have local defaults)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerceappdb
DB_USERNAME=root
DB_PASSWORD=

# Required: HMAC key used to sign JWTs. Use a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=
